# RecoverAI Environment Configuration

PROJECT_NAME=RecoverAI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./recover_ai.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/recover_ai

# Razorpay Test Mode API Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Agent Configuration
OPENAI_API_KEY=placeholder_openai_key
AI_MODEL_NAME=gpt-4o-mini

# Risk & Policy Defaults
MIN_RECOVERY_PROBABILITY_THRESHOLD=0.30
MAX_AUTOMATIC_RETRY_ATTEMPTS=3
HIGH_VALUE_ESCALATION_THRESHOLD_PAISE=10000000  # ₹1,00,000 in paise
RECOVERY_WINDOW_DAYS=30
