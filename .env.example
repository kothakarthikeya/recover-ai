# RecoverAI Global Environment Configuration Reference

# Backend Configuration
PROJECT_NAME=RecoverAI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite local / PostgreSQL production)
DATABASE_URL=sqlite:///./recover_ai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/recover_ai

# Payment Execution Mode (simulation / razorpay_test)
PAYMENT_EXECUTION_MODE=simulation

# Razorpay Sandbox Credentials (Placeholder only - never commit real keys)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# AI Agent Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gpt-4o-mini

# Policy Threshold Defaults
MIN_RECOVERY_PROBABILITY_THRESHOLD=0.25
MAX_AUTOMATIC_RETRY_ATTEMPTS=2
HIGH_VALUE_ESCALATION_THRESHOLD_PAISE=10000000
RECOVERY_WINDOW_HOURS=72

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
